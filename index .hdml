<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Your Home Service Company | Professional Home Services</title>
<meta name="description" content="Reliable, professional home services. Request your free quote today.">
<meta name="theme-color" content="#10251f">

<meta property="og:title" content="Your Home Service Company">
<meta property="og:description" content="Professional home services you can trust.">
<meta property="og:type" content="website">
<meta property="og:image" content="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1200">

<style>
:root {
    --primary: #10251f;
    --secondary: #1e4236;
    --accent: #c6a76b;
    --background: #f8f8f5;
    --white: #ffffff;
    --text: #242c28;
    --muted: #727a75;
    --radius: 14px;
    --shadow: 0 10px 35px rgba(0,0,0,.07);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.65;
}

a {
    text-decoration: none;
    color: inherit;
}

button, input, select, textarea {
    font: inherit;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

.container {
    width: min(1150px, 90%);
    margin: auto;
}

section {
    padding: 90px 0;
}

.section-label {
    color: var(--accent);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.section-heading {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    color: var(--primary);
    margin-bottom: 18px;
}

.section-description {
    color: var(--muted);
    max-width: 600px;
}

.btn {
    display: inline-block;
    padding: 14px 25px;
    border-radius: 6px;
    font-weight: 700;
    transition: .25s;
    cursor: pointer;
    border: 2px solid transparent;
}

.btn-primary {
    background: var(--accent);
    color: var(--primary);
}

.btn-primary:hover {
    background: #d7bc88;
    transform: translateY(-3px);
}

.btn-outline {
    border-color: rgba(255,255,255,.7);
    color: white;
}

.btn-outline:hover {
    background: white;
    color: var(--primary);
}

/* NAVIGATION */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255,255,255,.97);
    box-shadow: 0 2px 15px rgba(0,0,0,.05);
}

.navbar {
    min-height: 76px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--primary);
}

.logo span {
    color: var(--accent);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    list-style: none;
}

.nav-links a {
    font-size: .9rem;
    font-weight: 600;
    transition: .2s;
}

.nav-links a:hover {
    color: var(--accent);
}

.nav-cta {
    background: var(--primary);
    color: white !important;
    padding: 11px 19px;
    border-radius: 5px;
}

.menu-toggle {
    display: none;
    border: none;
    background: none;
    font-size: 1.8rem;
    cursor: pointer;
    color: var(--primary);
}

/* HERO */

.hero {
    min-height: 640px;
    display: flex;
    align-items: center;
    color: white;
    background:
        linear-gradient(90deg, rgba(8,24,19,.88), rgba(8,24,19,.35)),
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=1800")
        center/cover no-repeat;
}

.hero-content {
    max-width: 720px;
    padding: 100px 0;
}

.hero h1 {
    font-size: clamp(2.7rem, 6vw, 5rem);
    line-height: 1.08;
    margin-bottom: 24px;
}

.hero p {
    font-size: 1.1rem;
    color: rgba(255,255,255,.85);
    max-width: 570px;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.trust-row {
    display: flex;
    gap: 30px;
    margin-top: 55px;
    flex-wrap: wrap;
    color: white;
    font-size: .9rem;
}

.trust-row span::before {
    content: "✓ ";
    color: var(--accent);
    font-weight: bold;
}

/* SERVICES */

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 45px;
}

.service-card {
    background: white;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: .3s;
}

.service-card:hover {
    transform: translateY(-8px);
}

.service-card img {
    height: 220px;
}

.service-content {
    padding: 25px;
}

.service-content h3 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 1.25rem;
}

.service-content p {
    color: var(--muted);
    margin-bottom: 18px;
}

.text-link {
    color: var(--secondary);
    font-weight: 700;
}

/* ABOUT */

.about {
    background: white;
}

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 65px;
}

.about-image {
    height: 460px;
    border-radius: var(--radius);
    object-fit: cover;
}

.about-content p {
    color: var(--muted);
    margin: 18px 0;
}

.about-points {
    list-style: none;
    margin: 25px 0;
}

.about-points li {
    padding: 9px 0;
    font-weight: 600;
}

.about-points li::before {
    content: "✓";
    color: var(--accent);
    margin-right: 12px;
}

/* WHY CHOOSE US */

.features-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
    margin-top: 45px;
}

.feature {
    padding: 30px 20px;
    background: white;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.feature-icon {
    font-size: 2rem;
    margin-bottom: 18px;
}

.feature h3 {
    color: var(--primary);
    margin-bottom: 10px;
}

.feature p {
    font-size: .9rem;
    color: var(--muted);
}

/* PROCESS */

.process {
    background: var(--primary);
    color: white;
}

.process .section-heading {
    color: white;
}

.process .section-description {
    color: #c4d0ca;
}

.process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 35px;
    margin-top: 45px;
}

.process-step {
    border-top: 1px solid rgba(255,255,255,.3);
    padding-top: 25px;
}

.step-number {
    color: var(--accent);
    font-size: 2rem;
    font-weight: 800;
}

.process-step h3 {
    margin: 12px 0;
}

.process-step p {
    color: #c4d0ca;
}

/* REVIEWS */

.reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 40px;
}

.review-card {
    background: white;
    padding: 30px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.stars {
    color: var(--accent);
    letter-spacing: 4px;
    margin-bottom: 15px;
}

.review-card p {
    color: var(--muted);
    margin-bottom: 20px;
}

.review-card h4 {
    color: var(--primary);
}

.placeholder-label {
    font-size: .75rem;
    color: #a07835;
    font-weight: 700;
    margin-bottom: 12px;
    display: block;
}

/* GALLERY */

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 40px;
}

.gallery-grid img {
    height: 260px;
    border-radius: 8px;
    transition: .3s;
}

.gallery-grid img:hover {
    transform: scale(1.025);
}

/* QUOTE FORM */

.quote {
    background: #edf0eb;
}

.quote-grid {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 60px;
    align-items: start;
}

.quote-info p {
    color: var(--muted);
    margin-top: 20px;
}

.quote-form {
    background: white;
    padding: 35px;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group.full {
    grid-column: 1 / -1;
}

.form-group label {
    font-size: .85rem;
    font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 13px;
    border: 1px solid #dce1dc;
    border-radius: 5px;
    background: #fafbf9;
    width: 100%;
}

.form-group textarea {
    resize: vertical;
    min-height: 110px;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: 2px solid var(--accent);
    border-color: transparent;
}

.quote-form button {
    margin-top: 20px;
    width: 100%;
}

.form-message {
    margin-top: 15px;
    font-weight: 600;
    color: var(--secondary);
    display: none;
}

/* FAQ */

.faq-list {
    max-width: 800px;
    margin: 40px auto 0;
}

.faq-item {
    background: white;
    margin-bottom: 12px;
    border-radius: 8px;
    overflow: hidden;
}

.faq-question {
    width: 100%;
    background: none;
    border: none;
    text-align: left;
    padding: 22px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    color: var(--primary);
}

.faq-answer {
    display: none;
    padding: 0 22px 22px;
    color: var(--muted);
}

.faq-item.active .faq-answer {
    display: block;
}

.faq-item.active .faq-question span {
    transform: rotate(45deg);
}

/* CONTACT */

.contact {
    background: var(--secondary);
    color: white;
}

.contact .section-heading {
    color: white;
}

.contact .section-description {
    color: #d0ddd5;
}

.contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 40px;
}

.contact-card {
    background: rgba(255,255,255,.08);
    padding: 25px;
    border-radius: 8px;
}

.contact-card h3 {
    margin-bottom: 10px;
    color: var(--accent);
}

/* FOOTER */

footer {
    background: #0a1914;
    color: white;
    padding: 55px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
    margin-bottom: 40px;
}

footer h3 {
    margin-bottom: 15px;
}

footer p, footer a {
    color: #b6c0ba;
    font-size: .9rem;
}

footer ul {
    list-style: none;
}

footer li {
    margin: 8px 0;
}

footer a:hover {
    color: var(--accent);
}

.footer-bottom {
    border-top: 1px solid #34423b;
    padding-top: 20px;
    color: #9ba79f;
    font-size: .8rem;
    text-align: center;
}

/* ANIMATIONS */

.reveal {
    opacity: 0;
    transform: translateY(25px);
    transition: .7s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* MOBILE */

@media(max-width: 850px) {
    .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        left: 0;
        width: 100%;
        background: white;
        flex-direction: column;
        padding: 25px;
        gap: 22px;
        box-shadow: var(--shadow);
    }

    .nav-links.active {
        display: flex;
    }

    .menu-toggle {
        display: block;
    }

    .services-grid,
    .reviews-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .about-grid,
    .quote-grid {
        grid-template-columns: 1fr;
    }

    .about-image {
        height: 350px;
    }
}

@media(max-width: 550px) {
    section {
        padding: 65px 0;
    }

    .hero {
        min-height: 620px;
    }

    .services-grid,
    .reviews-grid,
    .process-grid,
    .gallery-grid,
    .contact-grid,
    .features-grid,
    .footer-grid {
        grid-template-columns: 1fr;
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .quote-form {
        padding: 22px;
    }

    .trust-row {
        gap: 12px;
        flex-direction: column;
        margin-top: 35px;
    }
}

@media(prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
    }

    .reveal {
        opacity: 1;
        transform: none;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->
<header>
<nav class="navbar container">
    <a href="#home" class="logo">YOUR BUSINESS<span>.</span></a>

    <button class="menu-toggle" aria-label="Toggle navigation"
        aria-expanded="false" aria-controls="navLinks">☰</button>

    <ul class="nav-links" id="navLinks">
        <li><a href="#home">Home</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#reviews">Reviews</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="#quote" class="nav-cta">Get a Free Quote</a></li>
    </ul>
</nav>
</header>

<main>

<!-- HERO -->
<section class="hero" id="home">
<div class="container">
    <div class="hero-content">
        <div class="section-label">YOUR LOCAL HOME SERVICE EXPERTS</div>

        <h1>Quality Service.<br>Lasting Results.</h1>

        <p>
            Professional, reliable home services designed to make your life
            easier. We take pride in every job and deliver results you can trust.
        </p>

        <div class="hero-buttons">
            <a href="#quote" class="btn btn-primary">Get a Free Quote</a>
            <a href="#services" class="btn btn-outline">Explore Services</a>
        </div>

        <div class="trust-row">
            <span>Reliable Service</span>
            <span>Free Estimates</span>
            <span>Customer Focused</span>
        </div>
    </div>
</div>
</section>

<!-- SERVICES -->
<section id="services">
<div class="container">
    <div class="section-label">WHAT WE DO</div>
    <h2 class="section-heading">Our Professional Services</h2>
    <p class="section-description">
        From routine maintenance to specialized home services,
        we have solutions to help keep your property looking its best.
    </p>

    <div class="services-grid">

        <article class="service-card reveal">
            <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=700"
                 alt="Beautiful residential property">
            <div class="service-content">
                <h3>Service One</h3>
                <p>Professional service tailored to your property's needs.</p>
                <a href="#quote" class="text-link">Request a Quote →</a>
            </div>
        </article>

        <article class="service-card reveal">
            <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=700"
                 alt="Modern home exterior">
            <div class="service-content">
                <h3>Service Two</h3>
                <p>Reliable solutions that help maintain your home.</p>
                <a href="#quote" class="text-link">Request a Quote →</a>
            </div>
        </article>

        <article class="service-card reveal">
            <img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=700"
                 alt="Clean modern residential space">
            <div class="service-content">
                <h3>Service Three</h3>
                <p>Quality workmanship and attention to every detail.</p>
                <a href="#quote" class="text-link">Request a Quote →</a>
            </div>
        </article>

    </div>
</div>
</section>

<!-- ABOUT -->
<section class="about" id="about">
<div class="container about-grid">
    <img class="about-image reveal"
         src="https://images.unsplash.com/photo-1600607687644-c7171b42498f?w=900"
         alt="Beautifully maintained home">

    <div class="about-content reveal">
        <div class="section-label">ABOUT OUR BUSINESS</div>
        <h2 class="section-heading">A Better Standard of Home Service</h2>

        <p>
            We are a locally focused home service business committed to
            delivering dependable work and excellent customer experiences.
        </p>

        <p>
            We believe every customer deserves honest communication,
            quality results, and service they can feel confident about.
        </p>

        <ul class="about-points">
            <li>Friendly and professional service</li>
            <li>Attention to detail</li>
            <li>Clear and honest communication</li>
            <li>Commitment to customer satisfaction</li>
        </ul>

        <a href="#contact" class="btn btn-primary">Get to Know Us</a>
    </div>
</div>
</section>

<!-- WHY CHOOSE US -->
<section>
<div class="container">
    <div class="section-label">THE DIFFERENCE</div>
    <h2 class="section-heading">Why Choose Our Team?</h2>

    <div class="features-grid">
        <div class="feature reveal">
            <div class="feature-icon">⭐</div>
            <h3>Quality Work</h3>
            <p>We focus on delivering consistent, high-quality results.</p>
        </div>

        <div class="feature reveal">
            <div class="feature-icon">🤝</div>
            <h3>Customer First</h3>
            <p>Your satisfaction and experience matter to us.</p>
        </div>

        <div class="feature reveal">
            <div class="feature-icon">⏰</div>
            <h3>Dependable</h3>
            <p>We value your time and communicate clearly.</p>
        </div>

        <div class="feature reveal">
            <div class="feature-icon">💬</div>
            <h3>Easy Communication</h3>
            <p>Getting information and requesting a quote is simple.</p>
        </div>
    </div>
</div>
</section>

<!-- PROCESS -->
<section class="process">
<div class="container">
    <div class="section-label">SIMPLE AND STRAIGHTFORWARD</div>
    <h2 class="section-heading">How It Works</h2>
    <p class="section-description">
        Getting professional home services shouldn't be complicated.
    </p>

    <div class="process-grid">
        <div class="process-step reveal">
            <div class="step-number">01</div>
            <h3>Request a Quote</h3>
            <p>Tell us what you need using our simple online quote form.</p>
        </div>

        <div class="process-step reveal">
            <div class="step-number">02</div>
            <h3>Confirm Your Booking</h3>
            <p>We'll discuss your requirements and arrange a suitable time.</p>
        </div>

        <div class="process-step reveal">
            <div class="step-number">03</div>
            <h3>Enjoy the Results</h3>
            <p>Our team completes the requested service with care.</p>
        </div>
    </div>
</div>
</section>

<!-- REVIEWS -->
<section id="reviews">
<div class="container">
    <div class="section-label">CUSTOMER FEEDBACK</div>
    <h2 class="section-heading">What Our Customers Say</h2>
    <p class="section-description">
        We value every customer and continuously work to improve our service.
    </p>

    <div class="reviews-grid">
        <article class="review-card reveal">
            <span class="placeholder-label">PLACEHOLDER — REPLACE WITH REAL REVIEW</span>
            <div class="stars">★★★★★</div>
            <p>"Add a genuine customer testimonial here once you receive permission to publish it."</p>
            <h4>Customer Name</h4>
        </article>

        <article class="review-card reveal">
            <span class="placeholder-label">PLACEHOLDER — REPLACE WITH REAL REVIEW</span>
            <div class="stars">★★★★★</div>
            <p>"Add another genuine review describing the customer's experience."</p>
            <h4>Customer Name</h4>
        </article>

        <article class="review-card reveal">
            <span class="placeholder-label">PLACEHOLDER — REPLACE WITH REAL REVIEW</span>
            <div class="stars">★★★★★</div>
            <p>"Replace this text with real feedback from a satisfied customer."</p>
            <h4>Customer Name</h4>
        </article>
    </div>
</div>
</section>

<!-- GALLERY -->
<section>
<div class="container">
    <div class="section-label">OUR WORK</div>
    <h2 class="section-heading">See the Difference</h2>
    <p class="section-description">
        A look at the properties and projects we work on.
        Replace these stock photos with your own business photography.
    </p>

    <div class="gallery-grid">
        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=700"
             alt="Residential property example" loading="lazy">
        <img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=700"
             alt="Home service project example" loading="lazy">
        <img src="https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?w=700"
             alt="Modern residential property" loading="lazy">
        <img src="https://images.unsplash.com/photo-1600607687644-c7171b42498f?w=700"
             alt="Home interior example" loading="lazy">
        <img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?w=700"
             alt="Residential space example" loading="lazy">
        <img src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?w=700"
             alt="Property maintenance example" loading="lazy">
    </div>
</div>
</section>

<!-- QUOTE FORM -->
<section class="quote" id="quote">
<div class="container quote-grid">

    <div class="quote-info">
        <div class="section-label">LET'S GET STARTED</div>
        <h2 class="section-heading">Request Your Free Quote</h2>

        <p>
            Tell us a little about your project and what you're looking for.
            We'll review your request and get back to you.
        </p>

        <p><strong>No obligation. No pressure.</strong></p>
    </div>

    <form class="quote-form" id="quoteForm">
        <div class="form-grid">

            <div class="form-group">
                <label for="name">Full Name *</label>
                <input id="name" name="name" type="text" required
                       placeholder="Your name">
            </div>

            <div class="form-group">
                <label for="email">Email Address *</label>
                <input id="email" name="email" type="email" required
                       placeholder="you@example.com">
            </div>

            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input id="phone" name="phone" type="tel"
                       placeholder="Your phone number">
            </div>

            <div class="form-group">
                <label for="service">Service Requested *</label>
                <select id="service" name="service" required>
                    <option value="">Select a service</option>
                    <option>Service One</option>
                    <option>Service Two</option>
                    <option>Service Three</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="form-group full">
                <label for="address">Property Address *</label>
                <input id="address" name="address" type="text" required
                       placeholder="Street address, city">
            </div>

            <div class="form-group">
                <label for="date">Preferred Date</label>
                <input id="date" name="date" type="date">
            </div>

            <div class="form-group">
                <label for="contactMethod">Preferred Contact Method</label>
                <select id="contactMethod" name="contactMethod">
                    <option>Email</option>
                    <option>Phone</option>
                    <option>Either</option>
                </select>
            </div>

            <div class="form-group full">
                <label for="message">Additional Information</label>
                <textarea id="message" name="message"
                          placeholder="Tell us more about your project..."></textarea>
            </div>

        </div>

        <button type="submit" class="btn btn-primary">
            Submit Quote Request
        </button>

        <p class="form-message" id="formMessage" role="status"
           aria-live="polite"></p>
    </form>

</div>
</section>

<!-- FAQ -->
<section id="faq">
<div class="container">
    <div class="section-label" style="text-align:center">QUESTIONS?</div>
    <h2 class="section-heading" style="text-align:center">
        Frequently Asked Questions
    </h2>

    <div class="faq-list">

        <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
                How do I get a quote? <span>+</span>
            </button>
            <div class="faq-answer">
                Simply complete our online quote form or contact us directly.
                We'll review your requirements and respond.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
                Do you offer free estimates? <span>+</span>
            </button>
            <div class="faq-answer">
                Yes, we offer free estimates for our services.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
                What areas do you service? <span>+</span>
            </button>
            <div class="faq-answer">
                We currently serve YOUR CITY and surrounding communities.
                Contact us to confirm availability in your area.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
                How can I pay? <span>+</span>
            </button>
            <div class="faq-answer">
                Contact us for information about our accepted payment methods.
            </div>
        </div>

        <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
                How quickly will you respond? <span>+</span>
            </button>
            <div class="faq-answer">
                We aim to respond to inquiries as soon as possible during
                our regular business hours.
            </div>
        </div>

    </div>
</div>
</section>

<!-- CONTACT -->
<section class="contact" id="contact">
<div class="container">
    <div class="section-label">GET IN TOUCH</div>
    <h2 class="section-heading">Let's Talk About Your Project</h2>
    <p class="section-description">
        Have questions or ready to get started? Reach out today.
    </p>

    <div class="contact-grid">
        <div class="contact-card">
            <h3>Phone</h3>
            <p><a href="tel:+15555555555">+1 (555) 555-5555</a></p>
        </div>

        <div class="contact-card">
            <h3>Email</h3>
            <p><a href="mailto:hello@example.com">hello@example.com</a></p>
        </div>

        <div class="contact-card">
            <h3>Service Area</h3>
            <p>Your City and surrounding areas</p>
        </div>
    </div>

    <div style="margin-top:35px">
        <a href="#quote" class="btn btn-primary">Request Your Free Quote</a>
    </div>

    <p style="margin-top:30px;color:#d0ddd5">
        Business Hours: Monday – Saturday, 8:00 AM – 6:00 PM
    </p>
</div>
</section>

</main>

<!-- FOOTER -->
<footer>
<div class="container">

    <div class="footer-grid">
        <div>
            <h3>YOUR BUSINESS<span style="color:var(--accent)">.</span></h3>
            <p>
                Professional home services with a commitment to quality,
                reliability, and customer satisfaction.
            </p>
        </div>

        <div>
            <h3>Quick Links</h3>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#about">About Us</a></li>
                <li><a href="#reviews">Reviews</a></li>
                <li><a href="#quote">Get a Quote</a></li>
            </ul>
        </div>

        <div>
            <h3>Contact</h3>
            <ul>
                <li><a href="tel:+15555555555">+1 (555) 555-5555</a></li>
                <li><a href="mailto:hello@example.com">hello@example.com</a></li>
                <li>Your City, Your Province</li>
            </ul>
        </div>
    </div>

    <div class="footer-bottom">
        © <span id="year"></span> Your Business Name. All rights reserved.
    </div>

</div>
</footer>

<script>
// MOBILE NAVIGATION

const menuToggle = document.querySelector(".menu-toggle");
const navLinks = document.querySelector(".nav-links");

menuToggle.addEventListener("click", () => {
    const isOpen = navLinks.classList.toggle("active");
    menuToggle.setAttribute("aria-expanded", isOpen);
    menuToggle.textContent = isOpen ? "✕" : "☰";
});

document.querySelectorAll(".nav-links a").forEach(link => {
    link.addEventListener("click", () => {
        navLinks.classList.remove("active");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.textContent = "☰";
    });
});

// FAQ ACCORDION

document.querySelectorAll(".faq-question").forEach(button => {
    button.addEventListener("click", () => {
        const item = button.parentElement;
        const isOpen = item.classList.toggle("active");

        button.setAttribute("aria-expanded", isOpen);

        document.querySelectorAll(".faq-item").forEach(other => {
            if (other !== item) {
                other.classList.remove("active");
                other.querySelector(".faq-question")
                    .setAttribute("aria-expanded", "false");
            }
        });
    });
});

// SCROLL ANIMATIONS

const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
        if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            observer.unobserve(entry.target);
        }
    });
}, { threshold: 0.12 });

document.querySelectorAll(".reveal").forEach(element => {
    observer.observe(element);
});

// AUTOMATIC COPYRIGHT YEAR

document.getElementById("year").textContent =
    new Date().getFullYear();

// QUOTE FORM

// Replace this with your real business email address.
const BUSINESS_EMAIL = "hello@example.com";

const quoteForm = document.getElementById("quoteForm");
const formMessage = document.getElementById("formMessage");

quoteForm.addEventListener("submit", function(event) {
    event.preventDefault();

    if (!quoteForm.reportValidity()) return;

    const data = new FormData(quoteForm);

    const subject = encodeURIComponent(
        "New Website Quote Request - " + data.get("name")
    );

    const body = encodeURIComponent(
`NEW QUOTE REQUEST

Name: ${data.get("name")}
Email: ${data.get("email")}
Phone: ${data.get("phone")}
Service: ${data.get("service")}
Address: ${data.get("address")}
Preferred Date: ${data.get("date")}
Preferred Contact: ${data.get("contactMethod")}

Additional Information:
${data.get("message")}
`
    );

    formMessage.style.display = "block";
    formMessage.textContent =
        "Your email application will open with your quote request. Please send the prepared email to complete your request.";

    window.location.href =
        "mailto:" + BUSINESS_EMAIL +
        "?subject=" + subject +
        "&body=" + body;
});
</script>

</body>
</html>
